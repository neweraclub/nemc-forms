# ==============================================================================
# NEW ERA CLUB (New Era Medical Club) — Environment Variables Template
# Copy this file to .env.local and configure your environment
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public client credentials
NEXT_PUBLIC_SUPABASE_URL=https://aysysyrjqhqrcqoinbgx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt_or_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-side credentials (bypasses RLS for secure Server Actions)
SUPABASE_URL=https://aysysyrjqhqrcqoinbgx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_or_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_jwt
SUPABASE_SECRET_KEY=your_supabase_secret_key

# ------------------------------------------------------------------------------
# SMTP Configuration (Nodemailer — nodejs runtime)
# ------------------------------------------------------------------------------
SMTP_HOST=mail.new-era-medical-club-univ-ouargla.dz
SMTP_PORT=587
SMTP_USER=contact@new-era-medical-club-univ-ouargla.dz
SMTP_PASS=your_smtp_password
# Note: SMTP_FROM email must match SMTP_USER for strict relay providers like Zoho Mail
SMTP_FROM="New Era Medical Club <contact@new-era-medical-club-univ-ouargla.dz>"
EMAIL_DEBUG=false

# ------------------------------------------------------------------------------
# Application Domain
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://form.new-era-medical-club-univ-ouargla.dz

# ------------------------------------------------------------------------------
# Superadmin Fallback Credentials (or authenticate via public.users superadmin)
# ------------------------------------------------------------------------------
STATIC_ADMIN_EMAIL=admin@new-era-medical-club-univ-ouargla.dz
STATIC_ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration (Email & Form Generator)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
